{
  "appId": "com.aviadox.app",
  "appName": "AviaDoX",
  "webDir": "www",
  "server": {
    "iosScheme": "capacitor",
    "androidScheme": "https"
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "LocalNotifications": {
      "smallIcon": "ic_stat_aviadox",
      "iconColor": "#1d4ed8",
      "sound": "default"
    },
    "PushNotifications": {
      "presentationOptions": ["badge", "sound", "alert"]
    }
  }
}
